    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import json\r\nimport os\r\n\r\nnames = IN[0]\r\nelevs = IN[1]\r\nids   = IN[2]\r\n\r\nif not isinstance(names, list):\r\n    names = [names]\r\n\r\nif not isinstance(elevs, list):\r\n    elevs = [elevs]\r\n\r\nif not isinstance(ids, list):\r\n    ids = [ids]\r\n    \r\noutput = []\r\n\r\nfor n, e, i in zip(names, elevs, ids):\r\n    output.append({\r\n        \"name\": n,\r\n        \"elevation\": e,\r\n        \"id\": i\r\n    })\r\nfile_path = r\"C:\\Users\\yhuang\\Downloads\\revit_automation_server\\export_levels.json\"\r\nwith open(file_path, 'w') as f:\r\n    json.dump(output, f, indent=4)\r\n# Output a list of dictionaries directly (NOT a JSON string!)\r\nOUT = output\r\n\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "2984365243c54392a04371742478dfda",
